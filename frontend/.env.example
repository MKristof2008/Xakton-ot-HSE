# Режим работы API: demo | live. Демо включён по умолчанию.
VITE_API_MODE=demo

# Маршрут проверки на backend (используется только в режиме live)
VITE_API_URL=/api/verify-text

# Лимит длины сообщения — согласовать с backend
VITE_MAX_TEXT_LENGTH=4000

# Таймаут запроса, мс
VITE_API_TIMEOUT_MS=20000
