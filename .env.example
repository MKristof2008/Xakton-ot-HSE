# Ключ к LLM. Без него пайплайн работает детерминированно (офлайн).
# С ним включается извлечение утверждений и оценка моделью.
# Файл в git не попадает (см. .gitignore).

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=45

# Детектор ИИ-генерации для фото. Пусто = модель по умолчанию
# (Ateeqq/ai-vs-human-image-detector). LAKMUS_AI_DETECTOR=0 отключает.
LAKMUS_AI_DETECTOR_MODEL=
LAKMUS_AI_DETECTOR=1
