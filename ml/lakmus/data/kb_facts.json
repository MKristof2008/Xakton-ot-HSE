  "patterns": [
    {
      "id": "pat_urgent_forward",
      "kind": "manipulation",
      "regex": "(?i)(срочно|перешли|разошли|сообщи всем|не молчи)",
      "note": "Призыв к срочной пересылке — признак манипуляции, не доказательство лжи"
    },
    {
      "id": "pat_anonymous_source",
      "kind": "manipulation",
      "regex": "(?i)(источник в правительстве|знакомый из|инсайд|по секрету|мне сказали)",
      "note": "Ссылка на анонимный источник вместо первоисточника"
    },
    {
      "id": "pat_absolute",
      "kind": "manipulation",
      "regex": "(?i)(всех уволят|всё отменят|полный запрет|навсегда|никогда больше)",
      "note": "Абсолютные формулировки без оговорок"
    },
    {
      "id": "pat_conspiracy",
      "kind": "manipulation",
      "regex": "(?i)(они скрывают|нам не говорят|замалчивают|тайно готовят)",
      "note": "Конспирологическая рамка"
    }
  ]
