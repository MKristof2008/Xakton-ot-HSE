# Ключи для live-прогона (этот файл НЕ попадает в git — см. .gitignore)
# Пример для AiTunnel (OpenAI-совместимый API):
LLM_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# Три уровня тарифов. Пусто = общий LLM_MODEL выше.
# LLM_MODEL_BASE=   # «База»: короткий вердикт
# LLM_MODEL_PLUS=   # «Плюс»: вердикт + разбор
# LLM_MODEL_MAX=    # «Макс»: полный анализ и готовая пересылка
